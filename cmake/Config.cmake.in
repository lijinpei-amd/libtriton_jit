@PACKAGE_INIT@

# Backend that was used to build this library
set(TritonJIT_BACKEND "@BACKEND@")

# Leave Public Dependency Resolution Later
include(CMakeFindDependencyMacro)

# Backend-specific dependencies
if(TritonJIT_BACKEND STREQUAL "CUDA" OR TritonJIT_BACKEND STREQUAL "IX")
    find_dependency(CUDAToolkit REQUIRED)
elseif(TritonJIT_BACKEND STREQUAL "NPU")
    # Create Ascend imported targets for downstream projects
    set(_ASCEND_TOOLKIT_HOME $ENV{ASCEND_TOOLKIT_HOME})
    if(NOT _ASCEND_TOOLKIT_HOME)
        set(_ASCEND_TOOLKIT_HOME "/usr/local/Ascend/ascend-toolkit/latest")
    endif()

    # Find CANN installation for runtime headers
    set(_CANN_HOME $ENV{CANN_HOME})
    if(NOT _CANN_HOME)
        file(GLOB _CANN_CANDIDATES "/usr/local/Ascend/cann-*")
        if(_CANN_CANDIDATES)
            list(GET _CANN_CANDIDATES 0 _CANN_HOME)
        endif()
    endif()

    # Detect architecture
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64")
        set(_ASCEND_ARCH_DIR "aarch64-linux")
    else()
        set(_ASCEND_ARCH_DIR "x86_64-linux")
    endif()

    if(EXISTS ${_ASCEND_TOOLKIT_HOME})
        find_library(_ASCENDCL_LIBRARY ascendcl PATHS ${_ASCEND_TOOLKIT_HOME}/lib64 NO_DEFAULT_PATH)
        if(_ASCENDCL_LIBRARY AND NOT TARGET Ascend::ascendcl)
            # Build include directories list
            set(_ASCEND_INCLUDE_DIRS "${_ASCEND_TOOLKIT_HOME}/include")
            if(_CANN_HOME AND EXISTS "${_CANN_HOME}/${_ASCEND_ARCH_DIR}/pkg_inc")
                list(APPEND _ASCEND_INCLUDE_DIRS "${_CANN_HOME}/${_ASCEND_ARCH_DIR}/pkg_inc")
            endif()

            add_library(Ascend::ascendcl SHARED IMPORTED)
            set_target_properties(Ascend::ascendcl PROPERTIES
                IMPORTED_LOCATION ${_ASCENDCL_LIBRARY}
                INTERFACE_INCLUDE_DIRECTORIES "${_ASCEND_INCLUDE_DIRS}"
            )
        endif()
    endif()
  elseif(TritonJIT_BACKEND STREQUAL "MLU")
    find_package(Python REQUIRED COMPONENTS Interpreter Development)
    if(NOT DEFINED TorchMLU_ROOT)
      execute_process(COMMAND ${Python_EXECUTABLE} "-c" "import torch_mlu;print(torch_mlu.utils.cmake_prefix_path)"
        OUTPUT_VARIABLE TorchMLU_ROOT
        OUTPUT_STRIP_TRAILING_WHITESPACE
      )
    endif()
    find_dependency(TorchMLU REQUIRED)
endif()

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(Torch MODULE REQUIRED)

if(TritonJIT_BACKEND STREQUAL "AMDGPU")
    # Align with the ROCm tree PyTorch just resolved. There is no override knob: the
    # HIP headers must describe the runtime PyTorch will load, so ENV{ROCM_PATH} is
    # the single point of control for both.
    if(NOT PYTORCH_FOUND_HIP)
        message(FATAL_ERROR
            "The AMDGPU TritonJIT package requires ROCm-enabled PyTorch, but PyTorch's "
            "CMake package did not configure HIP. Point the ROCM_PATH environment "
            "variable at the ROCm installation root before configuring.")
    endif()
    if(NOT hip_FOUND OR NOT hip_INCLUDE_DIRS)
        message(FATAL_ERROR
            "PyTorch configured HIP, but the hip CMake package did not provide its "
            "include directory")
    endif()
    message(STATUS "TritonJIT ROCm root (from PyTorch): ${ROCM_PATH}")

    execute_process(
        COMMAND ${Python_EXECUTABLE} -c
                "import torch; value = torch.version.hip; print(value if value is not None else '')"
        RESULT_VARIABLE _TRITON_JIT_TORCH_HIP_CHECK_RESULT
        OUTPUT_VARIABLE _TRITON_JIT_TORCH_HIP_VERSION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_VARIABLE _TRITON_JIT_TORCH_HIP_CHECK_ERROR)
    if(NOT _TRITON_JIT_TORCH_HIP_CHECK_RESULT EQUAL 0 OR
       _TRITON_JIT_TORCH_HIP_VERSION STREQUAL "")
        message(FATAL_ERROR
            "The AMDGPU TritonJIT package requires ROCm-enabled PyTorch. "
            "${_TRITON_JIT_TORCH_HIP_CHECK_ERROR}")
    endif()

    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _TRITON_JIT_ROCM_MAJOR_MINOR "${hip_VERSION}")
    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _TRITON_JIT_TORCH_MAJOR_MINOR
           "${_TRITON_JIT_TORCH_HIP_VERSION}")
    if(NOT _TRITON_JIT_ROCM_MAJOR_MINOR OR NOT _TRITON_JIT_TORCH_MAJOR_MINOR OR
       NOT _TRITON_JIT_ROCM_MAJOR_MINOR VERSION_EQUAL _TRITON_JIT_TORCH_MAJOR_MINOR)
        message(FATAL_ERROR
            "${ROCM_PATH} provides ROCm HIP ${hip_VERSION}, but PyTorch was built for "
            "HIP ${_TRITON_JIT_TORCH_HIP_VERSION}. Point ROCM_PATH at a matching ROCm "
            "installation.")
    endif()
endif()

if(TritonJIT_BACKEND STREQUAL "AMDGPU" AND NOT TARGET TritonJIT::amdgpu_host_api)
    add_library(TritonJIT::amdgpu_host_api INTERFACE IMPORTED)
    set_target_properties(TritonJIT::amdgpu_host_api PROPERTIES
        INTERFACE_COMPILE_DEFINITIONS "__HIP_PLATFORM_AMD__=1"
        INTERFACE_COMPILE_FEATURES "cxx_std_20"
        INTERFACE_INCLUDE_DIRECTORIES "${hip_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS}")
endif()

find_dependency(fmt)
if (NOT TARGET fmt::fmt)
  # use the fmt installed along with TritonJIT
  find_dependency(fmt REQUIRED PATHS "${CMAKE_CURRENT_LIST_DIR}/../fmt")
endif()

if (NOT TARGET TritonJIT::triton_jit)
  include("${CMAKE_CURRENT_LIST_DIR}/TritonJITTargets.cmake")
endif()

check_required_components(TritonJIT)
